# D8N HQ talks directly to each brand's own API host (see src/lib/brands.ts) —
# it is not same-origin with any one brand's frontend, unlike the per-brand
# consumer apps. Each entry needs an active CORS allowlist entry on that
# brand's Rails backend (D8N_CORS_ORIGINS) for this app's own origin before
# sign-in from a real browser will work; localhost is usually already
# allowlisted for dev.
#
# JSON array of { slug, label, apiBase }. slug must match the D8N brand slug
# (Brand#slug in the Rails backend) exactly — it's sent nowhere, only used to
# pick which host/token to use locally.
VITE_HQ_BRANDS=[{"slug":"dateza","label":"DateZA","apiBase":"http://localhost:3000"},{"slug":"hookus","label":"HookUs","apiBase":"http://localhost:3001"},{"slug":"date9ja","label":"Date9ja","apiBase":"http://localhost:3002"}]
